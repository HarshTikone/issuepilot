     "rpm": 0, "rpd": 0, "tpm": 0, "tpd": 0, "max_input_tokens": 0, "max_turns": 6},
    {"name": "groq", "hermes_provider": "custom", "model": "openai/gpt-oss-120b", "key_env": "GROQ_API_KEY",
     "base_url": "https://api.groq.com/openai/v1",
     "rpm": 30, "rpd": 1000, "tpm": 8000, "tpd": 200000, "max_input_tokens": 0, "max_turns": 6}
  ],
  "auth": "token",
  "app_id": 0,
  "installation_id": 0,
  "app_key_file": "",
  "heartbeat_url": "",
  "poll_seconds": 60,
  "timeout_seconds": 240,
